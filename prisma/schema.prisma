generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Money is stored as whole Kenyan shillings (Int). M-Pesa STK Push uses whole
// shillings too, and integers avoid floating-point rounding bugs.

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  MPESA
  CASH
  BANK
}

// Minimal stand-ins; replace with the full student/class models later.
model SchoolClass {
  id       Int            @id @default(autoincrement())
  name     String
  stream   String?
  students Student[]
  feeItems FeeStructure[]
  attendance Attendance[]
  assignments TeachingAssignment[]
}

model Student {
  id            Int       @id @default(autoincrement())
  admissionNo   String    @unique
  firstName     String
  lastName      String
  schoolClassId Int
  schoolClass   SchoolClass @relation(fields: [schoolClassId], references: [id])
  status        String    @default("active")
  gender        Gender?
  guardianName  String?   // parent or guardian contact name; separate from login accounts
  dateOfBirth   DateTime? @db.Date
  invoices      Invoice[]
  payments      Payment[]
  guardians     User[]    @relation("Guardians")
  attendance    Attendance[]
  marks         Mark[]
}

model Term {
  id           Int            @id @default(autoincrement())
  academicYear String         // calendar year, e.g. "2026"
  termNumber   Int            // 1..3
  startsOn     DateTime       @db.Date
  endsOn       DateTime       @db.Date
  feesDueOn    DateTime       @db.Date
  isCurrent    Boolean        @default(false)
  feeItems     FeeStructure[]
  invoices     Invoice[]
  exams        Exam[]

  @@unique([academicYear, termNumber])
}

// What a class is charged per term, itemised (Tuition, Boarding, Transport...)
model FeeStructure {
  id            Int         @id @default(autoincrement())
  schoolClassId Int
  termId        Int
  item          String
  amount        Int
  schoolClass   SchoolClass @relation(fields: [schoolClassId], references: [id])
  term          Term        @relation(fields: [termId], references: [id])
}

// One invoice per student per term
model Invoice {
  id         Int           @id @default(autoincrement())
  studentId  Int
  termId     Int
  amountDue  Int
  amountPaid Int           @default(0)
  status     InvoiceStatus @default(UNPAID)
  dueDate    DateTime      @db.Date
  student    Student       @relation(fields: [studentId], references: [id])
  term       Term          @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
}

model Payment {
  id                Int           @id @default(autoincrement())
  studentId         Int
  amount            Int
  method            PaymentMethod @default(MPESA)
  phone             String?       // 2547XXXXXXXX
  merchantRequestId String?
  checkoutRequestId String?       @unique
  mpesaReceipt      String?       @unique
  status            PaymentStatus @default(PENDING)
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  student           Student       @relation(fields: [studentId], references: [id])
}

enum Role {
  ADMIN
  TEACHER
  PARENT
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  role         Role
  children     Student[] @relation("Guardians") // only used for PARENT users
  attendanceMarked Attendance[] @relation("AttendanceMarker")
  assignments      TeachingAssignment[] // only used for TEACHER users
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// One row per student per school day.
model Attendance {
  id            Int              @id @default(autoincrement())
  studentId     Int
  schoolClassId Int              // class the student was in on that day
  date          DateTime         @db.Date
  status        AttendanceStatus
  markedById    Int
  student       Student          @relation(fields: [studentId], references: [id])
  schoolClass   SchoolClass      @relation(fields: [schoolClassId], references: [id])
  markedBy      User             @relation("AttendanceMarker", fields: [markedById], references: [id])

  @@unique([studentId, date])
  @@index([schoolClassId, date])
}

model Subject {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  marks       Mark[]
  assignments TeachingAssignment[]
}

// An assessment in a term, e.g. "Opening exam", "Mid-term", "End-term".
model Exam {
  id     Int    @id @default(autoincrement())
  termId Int
  name   String
  outOf  Int    @default(100)
  term   Term   @relation(fields: [termId], references: [id])
  marks  Mark[]

  @@unique([termId, name])
}

model Mark {
  id        Int     @id @default(autoincrement())
  examId    Int
  subjectId Int
  studentId Int
  score     Int
  exam      Exam    @relation(fields: [examId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([examId, subjectId, studentId])
  @@index([studentId])
}

enum Gender {
  MALE
  FEMALE
}

// Which class (and optionally which subject) a teacher is responsible for.
// subjectId = null means all subjects in that class. Replaced wholesale when an admin saves.
model TeachingAssignment {
  id            Int         @id @default(autoincrement())
  teacherId     Int
  schoolClassId Int
  subjectId     Int?
  teacher       User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolClass   SchoolClass @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  subject       Subject?    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([schoolClassId])
}
